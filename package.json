{
  "name": "user-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NestJS user service with Better Auth, grouped permissions, and internal API-key access",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^11.0.12",
    "@nestjs/core": "^11.0.12",
    "@nestjs/platform-express": "^11.0.12",
    "@prisma/client": "^6.17.1",
    "better-auth": "^1.7.3",
    "class-transformer": "^0.5.1",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "class-validator": "^0.14.1",
    "nodemailer": "^7.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@types/express": "^5.0.1",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "prettier": "^3.0.0",
    "prisma": "^6.17.1",
    "tsx": "^4.20.6",
    "typescript": "^5.8.2"
  }
}
