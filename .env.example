NODE_ENV=development
PORT=3001
ENABLE_API_DOCS=true
API_DOCS_BASE_PATH=
DATABASE_URL=postgresql://user_service:user_service@localhost:5433/user_service?schema=public
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
INTERNAL_API_KEY=replace-with-a-long-random-internal-key

# Optional Google OAuth credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional LINE Login channel credentials. Enable email address permission in LINE Developers.
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=

# Configure SMTP before production use. In development, verification links are logged locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=User Service <no-reply@example.com>


# Garage S3 storage (create an access key with access to both buckets)
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRIVATE_BUCKET=user-service
S3_PUBLIC_BUCKET=user-service-public
S3_PUBLIC_BASE_URL=http://user-service-public.web.garage.localhost:3902
