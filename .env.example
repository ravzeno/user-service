NODE_ENV=development
PORT=3001
ENABLE_API_DOCS=true
API_DOCS_BASE_PATH=
DATABASE_URL=postgresql://user_service:user_service@localhost:5433/user_service?schema=public
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
INTERNAL_API_KEY=replace-with-a-long-random-internal-key

# Optional Google OAuth credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional LINE Login channel credentials. Enable email address permission in LINE Developers.
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=

# Configure SMTP before production use. In development, verification links are logged locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=User Service <no-reply@example.com>

# Set after signing up and verifying the first account, then run npm run db:seed.
BOOTSTRAP_ADMIN_EMAIL=
